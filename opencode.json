{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4-pro"
    },
    "plan": {
      "model": "opencode-go/glm-5.3"
    },
    "general": {
      "model": "opencode-go/kimi-k2.7-code"
    },
    "explore": {
      "model": "opencode-go/glm-5.3-flash"
    }
  },
  "mcp": {
    "servers": {
      "context7": {
        "enabled": true,
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "engram": {
        "command": [
          "engram",
          "mcp",
          "--tools=agent"
        ],
        "type": "local"
      },
      "playwright": {
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "enabled": true,
        "type": "local"
      },
      "shadcn": {
        "command": [
          "npx",
          "shadcn@latest",
          "mcp"
        ],
        "enabled": true,
        "type": "local"
      },
      "supabase": {
        "enabled": true,
        "oauth": {},
        "type": "remote",
        "url": "https://mcp.supabase.com/mcp?project_ref=dzbtcisqvnoplsfrakbs&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
      }
    }
  },
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "git rebase *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "rsync *", "effect": "ask" },
    { "action": "shell", "resource": "scp *", "effect": "ask" },
    { "action": "shell", "resource": "sftp *", "effect": "ask" },
    { "action": "shell", "resource": "ssh *", "effect": "ask" },
    { "action": "read", "resource": "**/*.key", "effect": "deny" },
    { "action": "read", "resource": "**/*.pem", "effect": "deny" },
    { "action": "read", "resource": "**/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "**/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "**/.credentials/**", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.ssh/**", "effect": "deny" },
    { "action": "read", "resource": "**/Library/Keychains/**", "effect": "deny" },
    { "action": "read", "resource": "**/credentials.json", "effect": "deny" },
    { "action": "read", "resource": "**/secrets/**", "effect": "deny" }
  ],
  "share": "disabled"
}
